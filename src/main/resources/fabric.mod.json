  "license": "MIT",
  "icon": "assets/smpterminal/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.smpterminal.SmpTerminal"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${mc_range}",
    "fabric-api": "*",
    "java": ">=21"
  }
}
