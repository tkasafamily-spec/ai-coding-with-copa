     "text": "Every press: Pip loses a million dollars.",
     "start": 19.082,
     "end": 21.445
    }
   ]
  },
  {
   "start": 21.895,
   "len": 2.6,
   "lines": [
    {
     "who": "Mo",
     "text": "Bad idea, man.",
     "start": 22.045,
     "end": 23.116
    },
    {
     "who": "Pip",
     "text": "NOOO!",
     "start": 23.336,
     "end": 23.822
    }
   ]
  }
 ],
