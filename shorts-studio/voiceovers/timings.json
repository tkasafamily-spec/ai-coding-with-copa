{
 "500m-bucket": [
  {
   "start": 0.0,
   "len": 5.526,
   "lines": [
    {
     "who": "Narrator",
     "text": "Mr. Bucks said: fill this bucket in sixty seconds, and win five hundred million dollars.",
     "start": 0.05,
     "end": 5.076
    }
   ]
  },
  {
   "start": 5.526,
   "len": 4.228,
   "lines": [
    {
     "who": "Narrator",
     "text": "Easy, right? Pip grabbed a cup and ran to the pool.",
     "start": 5.676,
     "end": 8.394
    },
    {
     "who": "Pip",
     "text": "Easy money!",
     "start": 8.614,
     "end": 9.304
    }
   ]
  },
  {
   "start": 9.754,
   "len": 2.6,
   "lines": [
    {
     "who": "Narrator",
     "text": "But the bucket had a hole. A big one.",
     "start": 9.904,
     "end": 11.781
    }
   ]
  },
  {
   "start": 12.354,
   "len": 3.729,
   "lines": [
    {
     "who": "Mo",
     "text": "Bad idea, man. Just give up.",
     "start": 12.504,
     "end": 14.326
    },
    {
     "who": "Narrator",
     "text": "Pip did not give up.",
     "start": 14.546,
     "end": 15.633
    }
   ]
  },
  {
   "start": 16.083,
   "len": 2.6,
   "lines": [
    {
     "who": "Narrator",
     "text": "Then Quack had an idea.",
     "start": 16.233,
     "end": 17.436
    }
   ]
  },
  {
   "start": 18.683,
   "len": 2.6,
   "lines": [
    {
     "who": "Narrator",
     "text": "Pip filled it with three seconds left!",
     "start": 18.833,
     "end": 20.569
    }
   ]
  },
  {
   "start": 21.283,
   "len": 3.792,
   "lines": [
    {
     "who": "Narrator",
     "text": "Mr. Bucks handed over the money\u2026 to Quack.",
     "start": 21.433,
     "end": 23.749
    },
    {
     "who": "Pip",
     "text": "Wait, WHAT?!",
     "start": 23.969,
     "end": 24.625
    }
   ]
  }
 ],
 "pool-day": [
  {
