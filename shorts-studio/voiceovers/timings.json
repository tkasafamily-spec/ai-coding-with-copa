   ]
  },
  {
   "start": 19.116,
   "len": 4.173,
   "lines": [
    {
     "who": "Narrator",
     "text": "The coins\u2026 were chocolate.",
     "start": 19.266,
     "end": 20.517
    },
    {
     "who": "Mr. Bucks",
     "text": "I never said they were REAL!",
     "start": 20.737,
     "end": 22.84
    }
   ]
  }
 ],
 "press-the-button": [
  {
